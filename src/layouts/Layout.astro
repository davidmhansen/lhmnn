---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";
const { title } = Astro.props;
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead title={title} />
  </head>
  <body class="text-sm">
    <div
      class="md:grid md:grid-flow-col md:grid-cols-12 flex flex-col md:gap-4 gap-20"
    >
      <div
        class="flex md:flex-col justify-between md:justify-start col-span-5 md:col-span-6 md:gap-16"
      >
        <div>
          <a href="/"><h1 class="text-gray-950">David Lehmann</h1></a><span
            class="text-gray-500"
          >
            Resume
          </span>
        </div>
        <Navigation />
        <!-- Put profile image here -->
        <!-- <div class="w-2xs h-[400px] bg-amber-300 mt-16"></div> -->
      </div>

      <div class="col-span-6 md:col-span-6">
        <slot />
      </div>
    </div>
  </body>
</html>
