---
import Layout from "../layouts/Layout.astro";
---

<Layout title="photos">
  <div class="">
    <div class="flex flex-col gap-3 mb-[6rem] lg:mb-[12rem]">
      <p class="text-gray-500">
        At the end of each year, I look back through the photos I've taken and
        pick out my 12 favorites. It's inspired by Ansel Adams, who said:<br />
        <span class="italic text-gray-950"
          >"Twelve significant photographs in any one year is a good crop."</span
        >
      </p>
    </div>
    <ul class="flex gap-4">
      <li>
        <a class="tabular-nums" href="/">2025</a>
      </li>
      <li>
        <a class="tabular-nums" href="/">2024</a>
      </li>
      <li>
        <a class="tabular-nums" href="/">2023</a>
      </li>
      <li>
        <a class="tabular-nums" href="/">2022</a>
      </li>
    </ul>
  </div>
</Layout>
