---
interface Job {
  id: string;
  title: string;
  company: string;
  year: string;
  url: string;
}

interface Props {
  items: Job[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span class="text-gray-500">Work</span>
  <ul class="group/list">
    {
      items.map((job) => (
        <li class="group-hover/list:opacity-40 hover:!opacity-100 transition-opacity duration-300 motion-reduce:transition-none border-b border-gray-100 last:border-0">
          <a href={job.url} target="_blank" class="grid grid-cols-6 gap-2 py-3">
            <p class="col-span-3">{job.title}</p>
            <p class="col-span-1">{job.company}</p>
            <span class="col-span-2 text-end tabular-nums">{job.year}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
<style></style>
