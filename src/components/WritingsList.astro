---
interface Writing {
  id: string;
  title: string;
  year: string;
  date: string;
  link: string;
}

interface Props {
  writings: Writing[];
}

const { writings } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span class="text-gray-500">Writing</span>
  <ul class="group/list">
    {
      writings.map((writing) => (
        <li class="group-hover/list:opacity-40 hover:!opacity-100 transition-opacity duration-300 motion-reduce:transition-none border-b border-gray-100 last:border-0">
          <a href={writing.link} class="grid grid-cols-6 gap-2 py-3">
            <span class="col-span-1 tabular-nums">{writing.year}</span>
            <p class="col-span-4">{writing.title}</p>
            <span class="col-span-1 text-end tabular-nums">{writing.date}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
<style></style>
